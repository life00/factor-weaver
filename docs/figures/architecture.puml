@startuml
skinparam backgroundColor #FEFEFE
skinparam defaultFontName Helvetica
skinparam defaultFontSize 11
skinparam package {
  FontSize 12
  FontStyle bold
  BackgroundColor #EDF2F7
  BorderColor #2B6CB0
}
skinparam component {
  FontSize 10
  BackgroundColor #E8F4FD
  BorderColor #2B6CB0
}
skinparam arrow {
  Color #4A5568
  FontSize 9
}
skinparam rectangle {
  BackgroundColor #FEFCBF
  BorderColor #D69E2E
  FontSize 11
}

package "factor_weaver" {

  rectangle cli as "cli.py\nargparse + logging"
  rectangle config as "config.py\nYAML loading"

  package "workflows" as workflows {
    rectangle data_wf as "data\nfetch / build"
    rectangle train as "train\nmodel loop"
    rectangle evaluate as "evaluate\nbacktest"
    rectangle report as "report\nMLflow table"
  }

  package "data" as data_pkg {
    rectangle pipeline as "pipeline\nStep manifest + runner"
    rectangle store as "store\nparquet + caches"
    package "fetch" as fetch_pkg {
      rectangle lseg as "lseg\nreference + OHLCV"
      rectangle yahoo as "yahoo\nfallback + extras"
      rectangle f_prices as "prices\ncache orchestration"
    }
    package "build" as build_pkg {
      rectangle universe as "universe"
      rectangle b_prices as "prices"
      rectangle technicals as "technicals"
      rectangle panel as "panel"
      rectangle split as "split"
    }
  }

  package "models" as models_pkg {
    rectangle simple as "simple\n1/N, index buy-and-hold"
    rectangle optimize as "optimize\nshared tangency"
    rectangle mean_var as "mean_variance\nMarkowitz"
    rectangle bl as "black_litterman\nKolm & Ritter (2021) BLB"
    rectangle ml_fore as "ml_forecast\nGKX GBRT -> MV"
    package "rl" as rl_pkg {
      rectangle env as "env\nGymnasium env"
      rectangle model as "model\nencoder + actor/critic"
      rectangle ppo as "ppo\ntraining loop"
      rectangle policy as "policy\nweight-provider adapter"
    }
  }

  package "eval" as eval_pkg {
    rectangle backtest as "backtest\nshared daily engine"
  }

}

cli --> config
cli --> data_wf
cli --> train
cli --> evaluate
cli --> report

data_wf --> pipeline
pipeline --> fetch_pkg
pipeline --> build_pkg
fetch_pkg --> store
build_pkg --> store

train --> env
train --> model
train --> ppo
ppo --> env
ppo --> model

evaluate --> backtest
backtest ..> models_pkg : weights per rebalance
mean_var --> optimize
ml_fore --> optimize
bl --> optimize

note bottom of workflows
  `factor-weaver data [fetch|build] [steps ...]`
  `factor-weaver train [MODEL]`
  `factor-weaver eval [MODEL ...]`
  `factor-weaver report`
end note

note right of data_pkg
  Disk is the orchestrator.
  Each step declares config-key
  inputs/outputs; the runner pulls
  missing producers and caches fetches
  (existence = cached, --refresh bypasses).
end note

note right of models_pkg
  Everything producing
  portfolio weights is a
  weight-provider; the engine
  treats the RL policy and
  benchmarks identically.
end note

@enduml
