@startuml
skinparam backgroundColor #FEFEFE
skinparam defaultFontName Helvetica
skinparam defaultFontSize 11
skinparam package {
  FontSize 12
  FontStyle bold
  BackgroundColor #EDF2F7
  BorderColor #2B6CB0
}
skinparam component {
  FontSize 10
  BackgroundColor #E8F4FD
  BorderColor #2B6CB0
}
skinparam arrow {
  Color #4A5568
  FontSize 9
}
skinparam rectangle {
  BackgroundColor #FEFCBF
  BorderColor #D69E2E
  FontSize 11
}

package "factor_weaver" {

  rectangle cli as "cli.py\nargparse dispatcher"

  package "workflows" as workflows {
    rectangle build_dataset as "build_dataset\n13 data steps"
    rectangle train as "train\nRL loop"
    rectangle evaluate as "evaluate\nbacktest"
  }

  package "data" as data_pkg {
    rectangle parse_fund as "financialdatadb"
    rectangle lseg as "lseg"
    rectangle tickers as "tickers"
    rectangle universe as "universe"
    rectangle edgar as "edgar"
    rectangle prices as "prices"
    rectangle yahoo as "yahoo"
    rectangle technicals as "technicals"
    rectangle behavior as "behavior"
    rectangle align as "align"
    rectangle split as "split"
  }

  package "models" as models_pkg {
    rectangle simple as "simple\n1/N, index buy-and-hold"
    rectangle optimize as "optimize\nshared tangency"
    rectangle mean_var as "mean_variance\nMarkowitz"
    rectangle bl as "black_litterman\nKolm & Ritter (2021) BLB"
    rectangle ml_fore as "ml_forecast\nGKX GBRT -> MV"
    package "rl" as rl_pkg {
      rectangle env as "env\nGymnasium env"
      rectangle model as "model\nencoder + actor/critic"
      rectangle ppo as "ppo\ntraining loop"
      rectangle policy as "policy\nweight-provider adapter"
    }
  }

  package "eval" as eval_pkg {
    rectangle backtest as "backtest\nshared daily engine"
  }

  rectangle math as "math\nfinancial helpers"

}

cli --> build_dataset : run
cli --> train : run
cli --> evaluate : run

build_dataset --> parse_fund
build_dataset --> lseg
build_dataset --> universe
build_dataset --> edgar
build_dataset --> prices
prices --> yahoo
build_dataset --> technicals
build_dataset --> behavior
build_dataset --> align
build_dataset --> split

train --> env
train --> model
train --> ppo
ppo --> env
ppo --> model

evaluate --> backtest
backtest ..> models_pkg : weights per rebalance
mean_var --> optimize
ml_fore --> optimize
bl --> optimize

env --> math
backtest --> math

note bottom of workflows
  Each pipeline is a thin orchestrator.
  Data pipeline: `factor-weaver data [steps ...]`
  runs selected steps in order, empty = all.
end note

note right of data_pkg
  Disk is the orchestrator.
  Each step writes parquet,
  next step reads it.
  Fetch steps cache downloads
  (existence = cached).
end note

note right of models_pkg
  Everything producing
  portfolio weights is a
  weight-provider; the engine
  treats the RL policy and
  benchmarks identically.
end note

@enduml