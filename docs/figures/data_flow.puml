@startuml
skinparam backgroundColor #FEFEFE
skinparam defaultFontName Helvetica
skinparam defaultFontSize 11
skinparam component {
  FontSize 11
  BackgroundColor #E8F4FD
  BorderColor #2B6CB0
}
skinparam database {
  FontSize 10
  BackgroundColor #F0FFF0
  BorderColor #38A169
}
skinparam actor {
  BorderColor #805AD5
  BackgroundColor #F3E8FF
}
skinparam arrow {
  Color #4A5568
  FontSize 9
}

actor "financialdatadb\n(xlsx, 26 files)" as fdb
actor "LSEG data API\n(S&P500 list, OHLCV)" as lseg
actor "SEC EDGAR\n(filings API)" as edgar
actor "market-behavior\n(sibling repo)" as beh

database "data/raw/" as raw

rectangle "parse_fundamentals\nxlsx → long parquet" as parse_fundamentals
rectangle "parse_companies\n_US_listed_companies.xlsx → parquet" as parse_companies
rectangle "fetch_constituents\nS&P500 snapshot" as fetch_constituents
rectangle "fetch_joiners_leavers\nmembership changes since 1994" as fetch_joiners_leavers
rectangle "fetch_mapping\nRIC → ticker/PermID" as fetch_mapping
rectangle "fetch_market_cap\nquarterly, TR.CompanyMarketCap" as fetch_market_cap
rectangle "build_universe\ntop-50 S&P500" as build_universe
rectangle "fetch_filing_dates\nSEC submissions" as fetch_filing_dates
rectangle "fetch_prices\nOHLCV daily" as fetch_prices
rectangle "compute_technicals\nrolling indicators" as compute_technicals
rectangle "load_behavior\nsentiment/attention" as load_behavior
rectangle "align_dataset\nEDGAR-anchored merge" as align_dataset

database "fundamentals\n.parquet" as fund_pq
database "companies\n.parquet" as comp_pq
database "constituents\n.parquet" as cons_pq
database "joiners_leavers\n.parquet" as jl_pq
database "ric_mapping\n.parquet" as map_pq
database "market_cap\n.parquet" as cap_pq
database "universe\n.parquet" as univ_pq
database "filing_dates\n.parquet" as fd_pq
database "prices\n.parquet" as price_pq
database "technicals\n.parquet" as tech_pq
database "behavior\n.parquet" as beh_pq
database "data/processed/" as processed

fdb --> raw
lseg --> raw
edgar --> raw
beh --> raw

raw --> parse_fundamentals
parse_fundamentals --> fund_pq

raw --> parse_companies
parse_companies --> comp_pq

raw --> fetch_constituents
fetch_constituents --> cons_pq

raw --> fetch_joiners_leavers
fetch_joiners_leavers --> jl_pq

raw --> fetch_mapping
fetch_mapping --> map_pq

raw --> fetch_market_cap
fetch_market_cap --> cap_pq

cons_pq --> build_universe
jl_pq --> build_universe
map_pq --> build_universe
cap_pq --> build_universe
build_universe --> univ_pq

comp_pq --> fetch_filing_dates
univ_pq --> fetch_filing_dates
fetch_filing_dates --> fd_pq

univ_pq --> fetch_prices
fetch_prices --> price_pq

price_pq --> compute_technicals
compute_technicals --> tech_pq

raw --> load_behavior
load_behavior --> beh_pq

fund_pq --> align_dataset
fd_pq --> align_dataset
price_pq --> align_dataset
tech_pq --> align_dataset
beh_pq --> align_dataset
align_dataset --> processed

note right of align_dataset
  Forward-fill fundamentals anchored to EDGAR filing date
  (no look-ahead bias)
  Freshness counter for quarterly data
  Time-decay for behavioral features
end note

@enduml