@startuml
skinparam backgroundColor #FEFEFE
skinparam defaultFontName Helvetica
skinparam defaultFontSize 11
skinparam component {
  FontSize 11
  BackgroundColor #E8F4FD
  BorderColor #2B6CB0
}
skinparam database {
  FontSize 10
  BackgroundColor #F0FFF0
  BorderColor #38A169
}
skinparam actor {
  BorderColor #805AD5
  BackgroundColor #F3E8FF
}
skinparam arrow {
  Color #4A5568
  FontSize 9
}

actor "LSEG data API" as lseg
actor "Yahoo Finance\n(yfinance)" as yahoo
actor "MarketPsych\n(planned)" as mpsych

package "fetch — data/raw/ only" {
  rectangle "fetch_constituents" as f_cons
  rectangle "fetch_joiners_leavers" as f_jl
  rectangle "fetch_mapping" as f_map
  rectangle "fetch_market_cap" as f_cap
  rectangle "fetch_lseg_prices" as f_lp
  rectangle "fetch_yahoo_prices" as f_yp
}

database "constituents.parquet" as cons
database "joiners_leavers.parquet" as jl
database "ric_mapping.parquet" as map
database "market_cap.parquet" as cap
database "lseg/prices/<RIC>.parquet\n(yahoo/prices/<symbol>.parquet)" as pxcache

package "build — data/interim|processed only" {
  rectangle "build_universe\ntop-50 S&P500" as b_univ
  rectangle "build_prices\ncanonical OHLCV" as b_px
  rectangle "compute_technicals\nrolling indicators" as b_tech
  rectangle "build_panel\nreport-date anchored" as b_panel
  rectangle "split_dataset\ntrain / test" as b_split
}

database "universe.parquet\ncompanies.parquet" as univ
database "prices.parquet\nextra_prices.parquet" as px
database "technicals.parquet" as tech
database "panel.parquet" as panel
database "train.parquet\ntest.parquet" as splits

lseg --> f_cons
lseg --> f_jl
lseg --> f_map
lseg --> f_cap
lseg --> f_lp
yahoo --> f_yp
mpsych ..> b_panel : behavioral (planned)

f_cons --> cons
f_jl --> jl
f_map --> map
f_cap --> cap
f_lp --> pxcache
f_yp --> pxcache

cons --> b_univ
jl --> b_univ
map --> b_univ
cap --> b_univ
b_univ --> univ

univ --> b_px
pxcache --> b_px
b_px --> px

px --> b_tech
b_tech --> tech
px --> b_panel
tech --> b_panel
b_panel --> panel
panel --> b_split
b_split --> splits

note right of f_lp
  Existence = cached:
  whole-step skip for reference files,
  per-RIC / per-symbol skip for prices.
  --refresh refetches selected steps.
end note

note right of b_panel
  Forward-fill LSEG fundamentals from
  report dates; time-decay behavioral
  features. Strictly no look-ahead.
end note

@enduml
